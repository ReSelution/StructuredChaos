option('enable_chaos_stats', type: 'boolean', value: false, description: 'Enable Chaos Stats')
option('dump_magpie', type: 'boolean', value: false, description: 'Enable Magpie Dumping')
option(
  'mimalloc_new_delete',
  type: 'boolean',
  value: true,
  description: 'Route operator new/delete of every executable that uses sc_dep to mimalloc (Windows only)',
)
option(
  'ecs_comparison',
  type: 'boolean',
  value: false,
  description: 'Build the benchmarks that compare sc::ecs2 with other ECS libraries',
)

# Meson port of the options in mimalloc's CMakeLists.txt (v3.5.x).
# MI_FOO becomes mi_foo; the ON/OFF/... choices are written in lower case.
# The options CMake only keeps as deprecated aliases are left out.
# Example: meson setup build -Dmimalloc:mi_secure=on

option(
  'mi_secure',
  type: 'combo',
  choices: ['off', 'on', 'full'],
  value: 'off',
  description: 'Use security mitigations (like meta data guard pages, allocation randomization, double-free mitigation, and free-list corruption detection). full adds guard pages at the end of each mimalloc page (which may be expensive)',
)
option(
  'mi_override',
  type: 'boolean',
  value: true,
  description: 'Override the standard malloc interface (i.e. define entry points for malloc, free, etc)',
)
option(
  'mi_xmalloc',
  type: 'boolean',
  value: false,
  description: 'Enable abort() call on memory allocation failure by default',
)
option(
  'mi_show_errors',
  type: 'boolean',
  value: false,
  description: 'Show error and warning messages by default (only enabled by default in DEBUG mode)',
)
option(
  'mi_guarded',
  type: 'combo',
  choices: ['off', 'on', 'full', 'default'],
  value: 'default',
  description: 'Build with ability to put guard pages behind certain object allocations',
)
option(
  'mi_use_cxx',
  type: 'combo',
  choices: ['off', 'on', 'default'],
  value: 'default',
  description: 'Use the C++ compiler to compile the library (instead of the C compiler)',
)
option(
  'mi_opt_arch',
  type: 'string',
  value: 'default',
  description: 'Only for optimized builds: turn on architecture specific optimizations: off, on, default, or a specific one like avx2, armv8.1, armv8.3, rva22, rva23, rv64gcb_zacas (on: x64 -march=haswell -mavx2, arm64 -march=armv8.1-a)',
)
option(
  'mi_opt_simd',
  type: 'boolean',
  value: false,
  description: 'Use SIMD instructions (requires mi_opt_arch to be enabled)',
)
option(
  'mi_debug',
  type: 'combo',
  choices: ['off', 'on', 'internal', 'full', 'default'],
  value: 'default',
  description: 'Enable assertion checks. internal adds extra internal invariant checks, while full adds expensive heap invariant checks',
)
option(
  'mi_track',
  type: 'combo',
  choices: ['off', 'asan', 'valgrind', 'etw'],
  value: 'off',
  description: 'Enable tracking: asan (address sanitizer), valgrind, etw (Windows event tracing). Adds a small overhead',
)
option(
  'mi_stats',
  type: 'combo',
  choices: ['off', 'on', 'full', 'default'],
  value: 'default',
  description: 'Enable statistics',
)
option(
  'mi_profile',
  type: 'combo',
  choices: ['off', 'on', 'full', 'default'],
  value: 'default',
  description: 'Enable profiling',
)
option(
  'mi_free_is_checked',
  type: 'combo',
  choices: ['off', 'shared', 'on', 'default'],
  value: 'default',
  description: 'Check for invalid pointers in mi_free. shared enables it only for the shared library',
)
option(
  'mi_allow_thp',
  type: 'combo',
  choices: ['off', 'on', 'full', 'default'],
  value: 'default',
  description: 'Enable transparent huge pages on Linux. full enables THP and also avoids splitting up huge pages during purging',
)
option(
  'mi_free_use_pagemap',
  type: 'boolean',
  value: false,
  description: 'Always use the page map when free-ing a pointer -- enable only for systems that do not support large OS aligned allocations well',
)

option(
  'mi_debug_tsan',
  type: 'boolean',
  value: false,
  description: 'Build with thread sanitizer (needs clang)',
)
option(
  'mi_debug_ubsan',
  type: 'boolean',
  value: false,
  description: 'Build with undefined-behavior sanitizer (needs clang++)',
)

option(
  'mi_build_shared',
  type: 'boolean',
  value: true,
  description: 'Build shared library',
)
option(
  'mi_build_static',
  type: 'boolean',
  value: true,
  description: 'Build static library',
)
option(
  'mi_build_object',
  type: 'boolean',
  value: true,
  description: 'Build object library',
)
option(
  'mi_build_tests',
  type: 'boolean',
  value: true,
  description: 'Build test executables',
)

option(
  'mi_osx_interpose',
  type: 'boolean',
  value: true,
  description: 'Use interpose to override standard malloc on macOS',
)
option(
  'mi_osx_zone',
  type: 'boolean',
  value: true,
  description: 'Use malloc zone to override standard malloc on macOS',
)
option(
  'mi_win_redirect',
  type: 'boolean',
  value: true,
  description: 'Use redirection module (mimalloc-redirect) on Windows if compiling mimalloc as a DLL',
)
option(
  'mi_win_redirect_arm64ec',
  type: 'boolean',
  value: false,
  description: 'Windows: link mimalloc-redirect-arm64ec (replaces CMAKE_GENERATOR_PLATFORM=arm64ec)',
)
option(
  'mi_win_init',
  type: 'combo',
  choices: ['crt_tls', 'raw_dllmain', 'tls_dllmain', 'fls', 'default'],
  value: 'default',
  description: 'Force Windows initialization strategy: crt_tls (default), raw_dllmain (use raw DLL main entry point), tls_dllmain (TLS entries with DllMain), fls (legacy fiber API)',
)
option(
  'mi_tls_model',
  type: 'combo',
  choices: ['local', 'pthreads', 'local_dynamic', 'win32', 'fixed', 'default'],
  value: 'default',
  description: 'Force TLS model: local (thread local variables), pthreads (pthread locals), local_dynamic (dlopen-compatible thread local storage (Unix)), win32 (direct Windows TLS slots), fixed (fixed thread local slots)',
)
option(
  'mi_tls_recurse_guard',
  type: 'boolean',
  value: false,
  description: 'Force a recursion check on thread local access (for mi_tls_model=local only)',
)
option(
  'mi_libc_musl',
  type: 'boolean',
  value: false,
  description: 'Enable this when linking with musl libc',
)

option(
  'mi_padding',
  type: 'boolean',
  value: false,
  description: 'Enable padding to detect heap block overflow (always on in DEBUG or SECURE mode, or with Valgrind/ASAN)',
)
option(
  'mi_no_padding',
  type: 'boolean',
  value: false,
  description: 'Force no use of padding even in DEBUG mode etc.',
)
option(
  'mi_skip_collect_on_exit',
  type: 'boolean',
  value: false,
  description: 'Skip collecting memory on program exit',
)
option(
  'mi_install_toplevel',
  type: 'boolean',
  value: false,
  description: 'Install directly into prefix instead of PREFIX/lib/mimalloc-version',
)
option(
  'mi_extra_cppdefs',
  type: 'array',
  value: [],
  description: 'Extra pre-processor definitions (e.g. -Dmi_extra_cppdefs=opt1=val1,opt2=val2)',
)
option(
  'mi_see_asm',
  type: 'boolean',
  value: false,
  description: 'Generate assembly files',
)
